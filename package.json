{
  "name": "mojangapiproxy",
  "version": "1.0.0",
  "description": "A proxy to use data from the mojang api in your apps without the need to worry about rate limits or cors policy",
  "main": "./dist/app.js",
  "scripts": {
    "build": "tsc --build",
    "start": "node ./dist/app.js",
    "test": "nodemon --ignore ./index/ ./dist/app.js"
  },
  "author": "Zeeraa",
  "dependencies": {
    "axios": "^1.13.5",
    "console-stamp": "^3.1.2",
    "express": "^5.2.1",
    "is-valid-uuid-v4": "^1.2.3",
    "morgan": "^1.10.1",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.0.9",
    "nodemon": "^3.1.11",
    "typescript": "^5.9.3"
  }
}
